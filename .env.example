# Public app configuration. Leave the API blank until the public BE is connected.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=

# Optional overrides for the verified public link in config/project-link.json.
# Default owner: kurumichans-team / slug: translacat-mobile
# Default project UUID: 55b79b33-07b9-4d4b-a3f8-cf24ea76b139
EXPO_OWNER=
EXPO_PROJECT_ID=

# Development defaults: com.krumichan.translacat.dev
# Preview defaults: com.krumichan.translacat.preview
# Production requires both explicitly registered production identifiers.
TRANSLACAT_ANDROID_PACKAGE=
TRANSLACAT_IOS_BUNDLE_IDENTIFIER=

# Leave this unset locally by default. In the Expo/EAS dashboard, create a File
# environment variable named GOOGLE_SERVICES_JSON for the selected build environment.
# EAS injects its remote file path; the Android cloud build checks that file exists.
# Do not paste JSON contents, FCM service-account keys, or APNs keys here.
GOOGLE_SERVICES_JSON=

# OAuth client secrets, user tokens, and Expo Push access tokens belong on the server.
