{
  "name": "translacat-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mts",
    "config:check": "node scripts/check-config.mjs",
    "config:public": "expo config --type public",
    "doctor": "npx expo-doctor",
    "build:development:android": "node scripts/build.mjs development android",
    "build:development:ios": "node scripts/build.mjs development ios",
    "build:device:android": "node scripts/build.mjs device android",
    "build:local:android": "node scripts/build-local-android.mjs",
    "build:preview:android": "node scripts/build.mjs preview android",
    "build:preview:ios": "node scripts/build.mjs preview ios",
    "build:production:android": "node scripts/build.mjs production android",
    "build:production:ios": "node scripts/build.mjs production ios"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.5.0",
    "@tanstack/react-query": "^5.104.3",
    "expo": "~58.0.14",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.8",
    "expo-linking": "~58.0.13",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@expo/env": "2.5.2",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eas-cli": "25.1.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
